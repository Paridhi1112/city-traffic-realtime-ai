# ═══════════════════════════════════════════════════════════
# Urban Traffic Brain — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your API keys

# ── AI ──
KIMI_API_KEY=your_kimi_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-128k

# ── Traffic Data ──
TOMTOM_API_KEY=your_tomtom_key
HERE_API_KEY=your_here_key

# ── Weather ──
OPENWEATHERMAP_API_KEY=your_owm_key
# Open-Meteo needs no key

# ── Events ──
TICKETMASTER_API_KEY=your_ticketmaster_key

# ── Maps ──
MAPBOX_TOKEN=your_mapbox_token
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# ── Database ──
POSTGRES_USER=trafficbrain
POSTGRES_PASSWORD=trafficbrain_secret
POSTGRES_DB=trafficbrain
DATABASE_URL=postgresql+asyncpg://trafficbrain:trafficbrain_secret@postgres:5432/trafficbrain
REDIS_URL=redis://redis:6379

# ── App ──
CITY_NAME=Mumbai
CITY_BBOX=18.89,72.77,19.27,72.99
POLLING_INTERVAL_SECONDS=60
AI_DECISION_INTERVAL_SECONDS=120
SIMULATION_MODE=false

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
